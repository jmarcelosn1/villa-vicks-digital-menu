{
  "name": "villa-vicks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/finalize-dist.mjs && node scripts/build-cardapio.mjs",
