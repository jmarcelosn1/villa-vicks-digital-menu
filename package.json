    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
